{
  "name": "waymarktag",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "极简新标签页扩展（Chrome / Firefox，Manifest V3）",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "vite build --watch --mode chrome",
    "dev:firefox": "vite build --watch --mode firefox",
    "serve": "node scripts/dev-server.mjs",
    "icons": "node scripts/make-icons.mjs",
    "extract-css": "node scripts/extract-css.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  }
}
