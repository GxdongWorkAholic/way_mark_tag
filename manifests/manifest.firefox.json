{
  "manifest_version": 3,
  "name": "WayMarkTag",
  "short_name": "WayMarkTag",
  "version": "1.0.0",
  "description": "极简新标签页：时钟、多引擎搜索、可翻页的常用网站面板，数据只存本机。",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "waymarktag@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
